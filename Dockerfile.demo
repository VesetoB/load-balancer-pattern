FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends nginx \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY backend/app.py /app/app.py
COPY nginx.conf /etc/nginx/nginx.conf

EXPOSE 80

CMD ["sh", "-c", "SERVER_NAME='Backend 1' PORT=8001 python /app/app.py & SERVER_NAME='Backend 2' PORT=8002 python /app/app.py & nginx -g 'daemon off;'"]
